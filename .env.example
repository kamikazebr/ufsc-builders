# Copy to .env and fill in. .env is gitignored — keep it that way.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# A THROWAWAY key that only ever touches a testnet.
# Never put a key holding real money in a file, a terminal, or a website.
PRIVATE_KEY=0x

# https://etherscan.io/apidashboard — one key covers 60+ chains since API V2.
# See docs/verify.md
ETHERSCAN_API_KEY=

# The class registry, deployed before the session
UFSC_BUILDERS=0x

# Gateway API key from thegraph.com/studio → API Keys.
# Different from the deploy key. Used by the Subgraph MCP — see docs/indexing.md
GRAPH_GATEWAY_API_KEY=

# The badge image, already pinned. Public network, resolves on ipfs.io too.
# Regenerate with: make pin   (see docs/pinata.md)
BADGE_CID=bafkreigpgwxwpaaocq5ut3g2sfaeadhqpei2r5nmlnbijcpr4uehppdl54

# https://app.pinata.cloud/developers/api-keys — only needed if you pin your own.
# Free tier: 1 GB, one gateway. Keep this out of git.
PINATA_JWT=
PINATA_GATEWAY=
